# Template only. Never put real passwords, API keys, or tokens in this file.
# It is tracked by git. Put your actual values in .env, which is gitignored.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"

# Must be the public HTTPS origin in production, for example
# "https://app.example.com". Every email link is built from this value, and a
# localhost or plain HTTP link is a strong signal that mail will be filtered.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

CRON_SECRET="replace-with-a-long-random-value"

# Payment proof storage. Leave these empty to use the local filesystem at
# PRIVATE_UPLOAD_DIR. Set them to store proofs in a private Supabase bucket,
# which is what serverless hosts such as Vercel require because they have no
# persistent disk. Create the bucket with "Public bucket" turned off.
PRIVATE_UPLOAD_DIR=""
SUPABASE_STORAGE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="payment-proofs"

EMAIL_PROVIDER="smtp"
EMAIL_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Rungika <no-reply@mail.example.com>"
EMAIL_REPLY_TO="support@example.com"
EMAIL_PROVIDER_URL=""

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_TLS_REJECT_UNAUTHORIZED="true"
SMTP_USER=""
SMTP_PASSWORD=""

SUPER_ADMIN_EMAIL="owner@example.com"
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_PASSWORD=""
