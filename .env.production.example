# Production environment for Rungika.
# Copy these into the hosting provider's environment variable settings.
# Never commit a filled-in copy of this file.
#
# The production host is rungika.site. NEXT_PUBLIC_APP_URL must be the https
# origin: every verification, password-reset, and invitation link is built from
# it, and an http or localhost link causes mail providers to filter the message.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"

NEXT_PUBLIC_APP_URL="https://www.rungika.site"
NEXT_PUBLIC_SUPPORT_EMAIL="support@rungika.site"

CRON_SECRET="replace-with-a-long-random-value"

# Payment proof storage. On Vercel there is no persistent disk, so proofs go to
# a private Supabase bucket. Create the bucket once in the Supabase dashboard and
# keep "Public bucket" OFF. The service role key bypasses row level security, so
# it must never reach the browser or be committed.
SUPABASE_STORAGE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="set-in-the-hosting-dashboard-not-here"
SUPABASE_STORAGE_BUCKET="payment-proofs"

EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
EMAIL_FROM="Rungika <no-reply@mail.rungika.site>"
EMAIL_REPLY_TO="support@rungika.site"

SUPER_ADMIN_EMAIL="karasiraken5@gmail.com"
SUPER_ADMIN_PASSWORD="set-once-in-the-hosting-dashboard-not-here"
